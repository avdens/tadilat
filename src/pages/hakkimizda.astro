---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TrustBadges from "../components/TrustBadges.astro";
import CTASection from "../components/CTASection.astro";
import { siteConfig } from "../data/siteConfig";

const teamMembers = [
  {
    name: "Hasan Usta",
    role: "Kurucu & Baş Usta",
    exp: "20 Yıl Usta Tecrübesi",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80",
    bio: "Çekirdekten yetişme 20 yıllık şantiye ve tadilat tecrübesiyle Konya'daki tüm kırım, tesisat, planlama ve anahtar teslim aşamalarını bizzat yönetir."
  },
  {
    name: "Mehmet Usta",
    role: "Fayans & Seramik Ustası",
    exp: "16 Yıl Usta Tecrübesi",
    image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=600&q=80",
    bio: "Banyo, mutfak ve zemin seramiklerinde lazer teraziyle milimetrik döşeme, çift kat su sürme yalıtımı ve sıfır hata işçilik uzmanı."
  },
  {
    name: "Ali Usta",
    role: "Alçı, Boya & Asma Tavan Ustası",
    exp: "18 Yıl Usta Tecrübesi",
    image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=600&q=80",
    bio: "Pürüzsüz saten alçı, Jotun ve silinebilir boya uygulamaları ile gizli LED ışıklı asma tavan ve niş tasarımlarında usta işçilik sunar."
  }
];

const brandPartners = [
  "Jotun Boya", "VitrA", "Fırat Boru", "Kütahya Porselen", "Geberit", "Schneider Electric", "Blum", "Çamsan Parke", "Knauf Alçıpan", "Weber"
];
---

<Layout 
  title={`Hakkımızda & Usta Ekibimiz | ${siteConfig.brandName}`}
  description="Konya'da 20 yıllık usta tecrübesi ve çekirdekten yetişme ekibimizle anahtar teslim ev, ofis, daire ve villa tadilatında aracısız güvenilir işçilik."
>
  <Breadcrumb items={[{ label: "Hakkımızda & Usta Ekibimiz" }]} />

  <!-- Hero Banner -->
  <section class="relative bg-anthracite-950 text-white py-20 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
      <img 
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80" 
        alt="HS Dekorasyon Konya" 
        class="w-full h-full object-cover"
      />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">
          20 Yıllık Usta Tecrübesi
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif-heading font-extrabold text-white tracking-tight mb-4">
          Aracısız, Komisyonsuz <br />
          <span class="gold-gradient-text">Doğrudan Ustasından</span> Tadilat.
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
          {siteConfig.brandName}, Konya'da tadilat yaptırmak isteyen ev sahiplerinin yaşadığı usta bulma derdini, taşeron karmaşasını ve sürpriz maliyetleri ortadan kaldırmak için kuruldu. 
          Kırımından boyasına, tesisatından dolabına kadar tüm işi tek elden ve sözleşmeli sabit fiyat garantisiyle teslim ediyoruz.
        </p>
      </div>
    </div>
  </section>

  <!-- Story & Vision -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-600 text-xs font-semibold uppercase tracking-wider">
            Hikayemiz & Usta Disiplini
          </span>
          <h2 class="text-3xl font-serif-heading font-bold text-anthracite-950">
            "Biz lafa değil, yaptığımız işin kalitesine bakarız."
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Yıllardır Konya'da çıraklıktan ustalığa adım adım edindiğimiz saha deneyimiyle yüzlerce daire, müstakil ev, dükkan ve ofis yeniledik. Selçuklu, Meram, Karatay başta olmak üzere Konya'nın dört bir yanında 550'den fazla mekanı teslim ettik.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            Bizim farkımız; araya komisyoncu veya taşeron sokmadan, bizzat işin başında duran usta ekibiyle çalışmanızdır. Su tesisatını sağlam çeker, seramiği teraziye alır, boyayı dalgasız atar ve günü gününe anahtarınızı teslim ederiz.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-2xl font-bold font-serif-heading text-gold-600 block mb-1">550+</span>
              <span class="text-xs text-slate-600 font-medium">Tamamlanan Usta İşi</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <span class="text-2xl font-bold font-serif-heading text-gold-600 block mb-1">5 Yıl</span>
              <span class="text-xs text-slate-600 font-medium">İşçilik Garantisi</span>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <img 
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80" 
              alt="HS Dekorasyon Konya Tadilat" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-anthracite-950 text-white p-6 rounded-2xl border border-gold-500/40 shadow-2xl max-w-xs hidden sm:block">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-8 h-8 rounded-full bg-gold-500 text-anthracite-950 font-bold flex items-center justify-center text-xs">
                ✓
              </div>
              <span class="text-xs font-bold text-gold-400">Sabit Fiyat Sözleşmesi</span>
            </div>
            <p class="text-[11px] text-slate-300">
              Keşif sonrası yazılı sözleşmeye yazılan fiyat sabittir; sonradan sürpriz ek masraf çıkarılmaz.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Pillars -->
  <TrustBadges />

  <!-- Leadership Team -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-600 text-xs font-semibold uppercase tracking-wider mb-3">
          İşinin Ehli Kadromuz
        </span>
        <h2 class="text-3xl font-serif-heading font-bold text-anthracite-950">
          Evinizi Emanet Ettiğiniz Usta Ekibimiz
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Her işimizde usta başımız bizzat şantiyenin başında durur; tesisatından boyasına her aşama titizlikle kontrol edilir.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-card-elevated hover:shadow-xl transition-all duration-300">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src={member.image} 
                alt={member.name} 
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-6">
              <span class="text-[11px] text-gold-600 font-bold uppercase tracking-wider block mb-1">
                {member.exp}
              </span>
              <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-1">
                {member.name}
              </h3>
              <p class="text-xs text-slate-500 font-medium mb-3">
                {member.role}
              </p>
              <p class="text-xs text-slate-600 leading-relaxed">
                {member.bio}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Materials & Brands Partner Wall -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs uppercase tracking-widest text-slate-400 font-bold block mb-6">
        Projelerimizde Yalnızca 1. Sınıf Kaliteli ve Garantili Malzemeleri Kullanıyoruz
      </span>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8">
        {brandPartners.map((brand) => (
          <div class="px-5 py-3 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 hover:border-gold-500/60 hover:text-gold-600 transition-colors">
            {brand}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
