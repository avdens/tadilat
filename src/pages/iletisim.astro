---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { siteConfig } from "../data/siteConfig";
import { services } from "../data/services";

const serviceDistricts = [
  "Selçuklu", "Meram", "Karatay", "Ereğli", "Akşehir", "Beyşehir", 
  "Seydişehir", "Cihanbeyli", "Kulu", "Çumra", "Tüm Konya Merkez ve İlçeleri"
];
---

<Layout 
  title={`İletişim & Ücretsiz Keşif Randevusu | ${siteConfig.brandName}`}
  description="Konya / Merkez ve Konya genelindeki şantiyelerimiz. Ücretsiz yerinde usta keşif randevusu almak için hemen bize ulaşın: +90 (530) 450 41 16."
>
  <Breadcrumb items={[{ label: "İletişim" }]} />

  <!-- Hero Header -->
  <section class="bg-anthracite-950 text-white py-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Konya Geneli Ücretsiz Keşif
      </span>
      <h1 class="text-3xl sm:text-5xl font-serif-heading font-extrabold text-white tracking-tight mb-4">
        Bize Ulaşın, <br />
        <span class="gold-gradient-text">İşinizi Konuşalım</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        Mekanınızı yerinde görmek ve ihtiyaçlarınıza özel doğrudan usta fiyatıyla anahtar teslim teklif hazırlamak için 24 saat içinde yanınızdayız.
      </p>
    </div>
  </section>

  <!-- Contact Cards & Form Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Contact Details & Info (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200 shadow-card-elevated space-y-6">
            <h2 class="text-2xl font-serif-heading font-bold text-anthracite-950">
              İletişim Bilgilerimiz
            </h2>

            <div class="space-y-4">
              <!-- Phone -->
              <a 
                href={`tel:${siteConfig.phoneRaw}`} 
                class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-gold-500 transition-colors group"
              >
                <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-600 shrink-0 group-hover:bg-gold-500 group-hover:text-anthracite-950 transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <span class="text-xs text-slate-600 font-semibold block">Telefon & Doğrudan Usta Hattı:</span>
                  <span class="text-base font-bold text-anthracite-950 group-hover:text-gold-600 transition-colors">{siteConfig.phone}</span>
                  <span class="text-[11px] text-emerald-700 font-bold block">Haftanın 7 Günü 08:00 - 20:00</span>
                </div>
              </a>

              <!-- WhatsApp -->
              <a 
                href={`https://wa.me/${siteConfig.whatsappRaw}?text=Merhaba,%20anahtar%20teslim%20tadilat%20hakkında%20bilgi%20ve%20ücretsiz%20keşif%20istiyorum.`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-4 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 hover:border-emerald-500 transition-colors group"
              >
                <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                </div>
                <div>
                  <span class="text-xs text-emerald-800 font-semibold block">WhatsApp Usta Hattı:</span>
                  <span class="text-base font-bold text-emerald-950">{siteConfig.whatsapp}</span>
                  <span class="text-[11px] text-emerald-800 font-bold block">Fotoğraf, Video ve Konum Gönderin</span>
                </div>
              </a>

              <!-- Email -->
              <a 
                href={`mailto:${siteConfig.email}`} 
                class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-gold-500 transition-colors group"
              >
                <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-600 shrink-0 group-hover:bg-gold-500 group-hover:text-anthracite-950 transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <span class="text-xs text-slate-600 font-semibold block">E-Posta:</span>
                  <span class="text-sm font-bold text-anthracite-950 group-hover:text-gold-600 transition-colors">{siteConfig.email}</span>
                  <span class="text-[11px] text-slate-600 block">Tadilat detaylarınızı yazılı olarak da iletebilirsiniz</span>
                </div>
              </a>

              <!-- Address -->
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
                <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-600 shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <span class="text-xs text-slate-600 font-semibold block">Adres & Faaliyet Bölgesi:</span>
                  <span class="text-sm font-bold text-anthracite-950 block">{siteConfig.address}</span>
                  <span class="text-xs text-slate-600 font-medium">{siteConfig.city} ve Tüm İlçeleri</span>
                </div>
              </div>
            </div>

            <!-- Service Districts -->
            <div class="pt-4 border-t border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-anthracite-950 block mb-3">
                Konya'da Aktif Hizmet Verilen Bölgeler:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {serviceDistricts.map((d) => (
                  <span class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium">
                    {d}
                  </span>
                ))}
              </div>
            </div>

          </div>

        </div>

        <!-- Right: Comprehensive Inspection Request Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-10 border border-slate-200 shadow-card-elevated">
            
            <div class="mb-8">
              <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block mb-1">
                24 Saat İçinde Randevu
              </span>
              <h2 class="text-2xl sm:text-3xl font-serif-heading font-bold text-anthracite-950">
                Ücretsiz Keşif & Teklif Talep Formu
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 mt-2">
                Bilgilerinizi bırakın; usta başımız projenizi incelemek ve yerinde ücretsiz lazer ölçüm randevusu vermek için sizi hemen arasın.
              </p>
            </div>

            <form id="contact-page-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">Adınız Soyadınız *</label>
                  <input 
                    type="text" 
                    id="contact-name" 
                    required 
                    placeholder="Örn: Ahmet Yılmaz"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                  />
                </div>
                <div>
                  <label for="contact-phone" class="block text-xs font-semibold text-slate-700 mb-1">Telefon Numaranız *</label>
                  <input 
                    type="tel" 
                    id="contact-phone" 
                    required 
                    placeholder="0530 450 41 16"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-district" class="block text-xs font-semibold text-slate-700 mb-1">İlçe / Mahalle *</label>
                  <input 
                    type="text" 
                    id="contact-district" 
                    required 
                    placeholder="Örn: Selçuklu Yazır, Meram Havzan"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                  />
                </div>
                <div>
                  <label for="contact-area" class="block text-xs font-semibold text-slate-700 mb-1">Tahmini Alan (m²)</label>
                  <input 
                    type="number" 
                    id="contact-area" 
                    placeholder="Örn: 135"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="contact-service" class="block text-xs font-semibold text-slate-700 mb-1">İlgilendiğiniz Hizmet *</label>
                <select 
                  id="contact-service" 
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                >
                  {services.map((s) => (
                    <option value={s.title}>{s.title}</option>
                  ))}
                  <option value="Diğer Özel Tadilat">Diğer Özel Tadilat / Dükkan / Villa</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1">Projeniz Hakkında Notlar</label>
                <textarea 
                  id="contact-message" 
                  rows="3" 
                  placeholder="Mekanınızın mevcut durumu, yapılmasını istediğiniz işler (örn: komple su tesisatı, banyo su yalıtımı, asma tavan, boya-badana)..."
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:outline-none focus:border-gold-500 focus:bg-white transition-colors"
                ></textarea>
              </div>

              <div class="pt-2">
                <button 
                  type="submit" 
                  class="w-full py-4 px-6 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-sm uppercase tracking-wider rounded-xl shadow-gold-glow hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Ücretsiz Keşif Randevusu Gönder</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </button>
              </div>

              <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2">
                <span>🔒 Bilgileriniz gizlidir, 3. şahıslara verilmez.</span>
                <span>⏱️ Ortalama dönüş: 15 dakika</span>
              </div>
            </form>

            <div id="contact-success" class="hidden text-center py-10 space-y-4">
              <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <h3 class="text-2xl font-serif-heading font-bold text-anthracite-950">Talebiniz Başarıyla Alındı!</h3>
              <p class="text-sm text-slate-600 max-w-md mx-auto">
                Usta başımız belirtmiş olduğunuz telefon üzerinden en kısa sürede sizinle iletişime geçecektir. Dilerseniz hemen WhatsApp üzerinden de fotoğrafları ileterek konuşmayı başlatabilirsiniz.
              </p>
              <a 
                id="contact-wa-direct" 
                href={`https://wa.me/${siteConfig.whatsappRaw}`}
                target="_blank"
                class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white font-bold text-xs uppercase tracking-wider rounded-xl hover:bg-emerald-500 transition-colors"
              >
                WhatsApp İle Hemen Devam Et →
              </a>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Interactive Map / Showroom Location -->
  <section class="py-12 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-anthracite-950 rounded-3xl p-4 sm:p-6 shadow-2xl border border-anthracite-800">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4 text-white">
          <div>
            <h3 class="text-lg font-bold font-serif-heading">HS Dekorasyon Konya / Merkez</h3>
            <p class="text-xs text-slate-400">Selçuklu, Meram, Karatay ve tüm Konya genelinde yerinde ücretsiz keşif hizmeti sunuyoruz.</p>
          </div>
          <a 
            href="https://maps.google.com/?q=Konya+Merkez" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg bg-gold-500 text-anthracite-950 font-bold text-xs hover:brightness-110 transition-all flex items-center gap-1.5"
          >
            <span>Google Haritalarda Aç</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <div class="aspect-[21/9] w-full rounded-2xl overflow-hidden border border-anthracite-800 bg-anthracite-900">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d100780.24522818968!2d32.417252!3d37.874641!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14d08568d615f745%3A0x240dd0ab0f601b96!2sKonya!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" 
            width="100%" 
            height="100%" 
            style="border:0; filter: invert(90%) hue-rotate(180deg);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ whatsappRaw: siteConfig.whatsappRaw }}>
  const form = document.getElementById('contact-page-form');
  const successBox = document.getElementById('contact-success');
  const waDirect = document.getElementById('contact-wa-direct');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('contact-name')?.value || '';
    const phone = document.getElementById('contact-phone')?.value || '';
    const district = document.getElementById('contact-district')?.value || '';
    const area = document.getElementById('contact-area')?.value || '';
    const service = document.getElementById('contact-service')?.value || '';
    const msg = document.getElementById('contact-message')?.value || '';

    const text = encodeURIComponent(
      `Merhaba HS Dekorasyon, İletişim sayfanızdan Konya için Ücretsiz Keşif formu doldurdum:\n` +
      `👤 İsim: ${name}\n` +
      `📞 Telefon: ${phone}\n` +
      `📍 İlçe/Mahalle: ${district}\n` +
      `📐 Alan: ${area ? area + ' m²' : 'Belirtilmedi'}\n` +
      `🔨 Hizmet: ${service}\n` +
      `📝 Mesaj: ${msg || 'Belirtilmedi'}`
    );

    if (waDirect) {
      waDirect.href = `https://wa.me/${whatsappRaw}?text=${text}`;
    }

    form.classList.add('hidden');
    successBox?.classList.remove('hidden');
  });
</script>
