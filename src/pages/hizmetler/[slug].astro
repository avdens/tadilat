---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import { siteConfig } from "../../data/siteConfig";
import { services, type ServiceItem } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": service.faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title={`${service.title} | ${siteConfig.brandName}`}
  description={service.shortDescription}
  image={service.heroImage}
>
  <Breadcrumb 
    items={[
      { label: "Hizmetlerimiz", href: "/hizmetler" },
      { label: service.title }
    ]} 
  />

  <!-- Hero Header -->
  <section class="relative bg-anthracite-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-30">
      <img 
        src={service.heroImage} 
        alt={service.title} 
        class="w-full h-full object-cover" 
      />
      <div class="absolute inset-0 bg-gradient-to-r from-anthracite-950 via-anthracite-950/80 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/15 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">
          {service.badge}
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif-heading font-extrabold text-white tracking-tight mb-4">
          {service.title}
        </h1>
        <p class="text-base sm:text-lg text-gold-200 font-medium mb-4">
          {service.subtitle}
        </p>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light mb-8 max-w-2xl">
          {service.shortDescription}
        </p>

        <!-- Metrics Pills -->
        <div class="flex flex-wrap items-center gap-4 mb-8 text-xs">
          <div class="flex items-center gap-2 bg-anthracite-900/80 border border-anthracite-700 px-3.5 py-2 rounded-xl text-white">
            <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Ortalama Süre: <strong>{service.estimatedDuration}</strong></span>
          </div>
          <div class="flex items-center gap-2 bg-anthracite-900/80 border border-anthracite-700 px-3.5 py-2 rounded-xl text-white">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Garanti: <strong>{service.warranty}</strong></span>
          </div>
          <div class="flex items-center gap-2 bg-anthracite-900/80 border border-gold-500/40 px-3.5 py-2 rounded-xl text-gold-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Sözleşmeli Sabit Fiyat</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <button 
            type="button" 
            data-open-inspection-modal
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-sm shadow-gold-glow hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Bu Hizmet İçin Ücretsiz Keşif Randevusu Al</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <a 
            href="/fiyat-hesapla"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-anthracite-900 border border-anthracite-700 hover:border-gold-500 text-white font-semibold text-sm hover:bg-anthracite-800 transition-all flex items-center justify-center gap-2"
          >
            <span>Maliyet Hesapla</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Scope & Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left content (8 cols) -->
        <div class="lg:col-span-8 space-y-12">
          
          <div>
            <span class="text-xs uppercase tracking-wider text-gold-600 font-bold block mb-2">Usta Yaklaşımımız</span>
            <h2 class="text-2xl sm:text-3xl font-serif-heading font-bold text-anthracite-950 mb-4">
              {service.title} Sürecinde Neler Yapıyoruz?
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              {service.fullDescription}
            </p>
          </div>

          <!-- Scope checklist -->
          <div>
            <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-4">
              Uygulama Kapsamı & İmalat Kalemleri
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {service.scope.map((item) => (
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-2.5 text-xs text-slate-800 font-medium">
                  <div class="w-5 h-5 rounded-full bg-gold-500/20 text-gold-700 flex items-center justify-center shrink-0 mt-0.5">
                    ✓
                  </div>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Step-by-Step Process Timeline for this service -->
          <div>
            <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-6">
              Adım Adım Nasıl Uyguluyoruz?
            </h3>
            <div class="space-y-4">
              {service.process.map((step) => (
                <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
                  <span class="w-10 h-10 rounded-lg bg-anthracite-950 text-gold-400 font-serif-heading font-bold flex items-center justify-center shrink-0 border border-gold-500/40">
                    {step.step}
                  </span>
                  <div>
                    <h4 class="text-sm font-bold text-anthracite-950 mb-1">{step.title}</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Gallery -->
          <div>
            <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-6">
              Örnek İmalat ve Detay Görselleri
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              {service.gallery.map((img, i) => (
                <div class="aspect-square rounded-xl overflow-hidden shadow-md group">
                  <img 
                    src={img} 
                    alt={`${service.title} Detay ${i + 1}`} 
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div>
            <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-4">
              Sıkça Sorulan Sorular
            </h3>
            <div class="space-y-3">
              {service.faq.map((item) => (
                <details class="p-4 rounded-xl bg-slate-50 border border-slate-200 group">
                  <summary class="font-bold text-xs sm:text-sm text-anthracite-950 cursor-pointer list-none flex items-center justify-between">
                    <span>{item.q}</span>
                    <span class="text-gold-600 transition-transform group-open:rotate-180">▼</span>
                  </summary>
                  <p class="text-xs text-slate-600 mt-3 pt-3 border-t border-slate-200 leading-relaxed">
                    {item.a}
                  </p>
                </details>
              ))}
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar (4 cols) -->
        <div class="lg:col-span-4">
          <div class="sticky top-28 space-y-6">
            
            <!-- Quick Contact Box -->
            <div class="bg-anthracite-950 text-white rounded-2xl p-6 border border-gold-500/30 shadow-2xl">
              <span class="text-[11px] font-bold uppercase tracking-wider text-gold-400 block mb-2">
                Hemen Fiyat & Keşif Alın
              </span>
              <h3 class="text-xl font-serif-heading font-bold mb-3">
                Bu Hizmet İçin Keşif İsteyin
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-6">
                Usta başımız mekanınızı Konya'da yerinde incelesin, ihtiyaçlarınızı belirleyip net sabit bütçeli teklifinizi sunalım.
              </p>

              <div class="space-y-3 mb-6">
                <a 
                  href={`tel:${siteConfig.phoneRaw}`} 
                  class="flex items-center gap-3 p-3 rounded-xl bg-anthracite-900 border border-anthracite-800 text-xs font-semibold hover:border-gold-500 transition-colors"
                >
                  <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  <span>{siteConfig.phone}</span>
                </a>

                <a 
                  href={`https://wa.me/${siteConfig.whatsappRaw}?text=Merhaba,%20${encodeURIComponent(service.title)}%20hizmetiniz%20için%20ücretsiz%20keşif%20randevusu%20almak%20istiyorum.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 p-3 rounded-xl bg-emerald-600/20 border border-emerald-500/40 text-emerald-300 text-xs font-semibold hover:bg-emerald-600 hover:text-white transition-colors"
                >
                  <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                  <span>WhatsApp ile Hızlı Mesaj</span>
                </a>
              </div>

              <button 
                type="button" 
                data-open-inspection-modal
                class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-xs uppercase tracking-wider shadow-gold-glow hover:brightness-110 active:scale-95 transition-all cursor-pointer"
              >
                Keşif Formu Doldur
              </button>
            </div>

            <!-- Materials used in this service -->
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
              <h4 class="text-xs uppercase font-bold tracking-wider text-anthracite-950 mb-3">
                Kullandığımız 1. Sınıf Markalar
              </h4>
              <div class="flex flex-wrap gap-2">
                {service.materials.map((m) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 font-medium">
                    {m}
                  </span>
                ))}
              </div>
            </div>

            <!-- Other Services list -->
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
              <h4 class="text-xs uppercase font-bold tracking-wider text-anthracite-950 mb-3">
                Diğer Hizmetlerimiz
              </h4>
              <ul class="space-y-2 text-xs">
                {services.filter(s => s.id !== service.id).map((other) => (
                  <li>
                    <a href={`/hizmetler/${other.slug}`} class="text-slate-600 hover:text-gold-600 font-medium flex items-center justify-between">
                      <span>{other.title}</span>
                      <span>→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection 
    title={`${service.title} İçin Keşif Randevunuzu Alın`}
    description="Usta ekibimizle mekanınızı Konya'da yerinde inceleyelim, kuruşu kuruşuna sabit bütçeli teklifinizi sunalım."
  />
</Layout>

