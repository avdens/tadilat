---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CTASection from "../../components/CTASection.astro";
import { siteConfig } from "../../data/siteConfig";
import { services } from "../../data/services";
---

<Layout 
  title={`Anahtar Teslim Tadilat Hizmetlerimiz | ${siteConfig.brandName}`}
  description="Konya'da ev, villa, ofis, mutfak-banyo ve komple bina tadilatında A'dan Z'ye doğrudan usta işçiliği. Sabit fiyat ve 5 yıl garanti."
>
  <Breadcrumb items={[{ label: "Hizmetlerimiz" }]} />

  <!-- Hero Header -->
  <section class="bg-anthracite-950 text-white py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">
          Usta İşçiliği & Taahhüt
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif-heading font-extrabold text-white tracking-tight mb-4">
          Tüm Mekanlar İçin <br />
          <span class="gold-gradient-text">Anahtar Teslim Çözümler</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
          İster tek bir banyo veya mutfak yenilemesi, ister komple lüks villa veya kurumsal ofis dönüşümü... İhtiyacınıza uygun profesyonel hizmetlerimizi keşfedin.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Service Comparison Table -->
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-wider text-gold-600 font-bold block mb-2">Karşılaştırmalı Genel Bakış</span>
        <h2 class="text-3xl font-serif-heading font-bold text-anthracite-950">
          Hangi Hizmet Ne Kadar Sürer ve Neleri Kapsar?
        </h2>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table class="w-full min-w-[680px] text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-anthracite-950 text-white border-b border-anthracite-800">
              <th class="p-4 font-semibold">Hizmet Türü</th>
              <th class="p-4 font-semibold">Ortalama Süre</th>
              <th class="p-4 font-semibold">İşçilik Garantisi</th>
              <th class="p-4 font-semibold">Usta Planlaması</th>
              <th class="p-4 font-semibold">Tesisat Sıfırlama</th>
              <th class="p-4 font-semibold">İncele</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            {services.map((s) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-4 font-bold text-anthracite-950">
                  <a href={`/hizmetler/${s.slug}`} class="hover:text-gold-600">
                    {s.title}
                  </a>
                </td>
                <td class="p-4 text-slate-600 font-medium">{s.estimatedDuration}</td>
                <td class="p-4 text-emerald-600 font-bold">{s.warranty}</td>
                <td class="p-4 text-slate-700">Ücretsiz Dahil</td>
                <td class="p-4 text-slate-700">Dahil (Basınç Testli)</td>
                <td class="p-4">
                  <a href={`/hizmetler/${s.slug}`} class="text-gold-600 font-bold hover:underline">
                    Detay →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

