---
import { siteConfig } from "../data/siteConfig";
import { services } from "../data/services";

const currentYear = new Date().getFullYear();
---

<footer class="bg-anthracite-950 text-slate-300 border-t border-anthracite-800 relative overflow-hidden">
  <!-- Subtle decorative glow -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-10 w-96 h-96 bg-gold-600/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Trust Bar above footer -->
  <div class="border-b border-anthracite-800/80 bg-anthracite-900/60 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center md:text-left">
        <div class="flex flex-col md:flex-row items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm">5 Yıl Resmi Garanti</h4>
            <p class="text-xs text-slate-400">Tüm işçilik ve tesisat imalatları garantilidir</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm">Sabit Fiyat Taahhüdü</h4>
            <p class="text-xs text-slate-400">Sözleşme sonrası asla ek masraf çıkmaz</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm">Zamanında Teslim</h4>
            <p class="text-xs text-slate-400">Günlük cezai şartlı noter onaylı sözleşme</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm">Foto-Gerçekçi 3D</h4>
            <p class="text-xs text-slate-400">Kırımdan önce evinizi 3D render ile görün</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Description (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-gold-400 via-gold-500 to-gold-700 flex items-center justify-center shadow-gold-glow">
            <svg class="w-6 h-6 text-anthracite-950 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-serif-heading font-bold tracking-tight text-white">
              ARTI <span class="text-gold-500 font-sans font-light text-base tracking-widest uppercase ml-1">MİMARLIK</span>
            </span>
            <span class="text-[10px] tracking-wider uppercase text-slate-400 font-medium">
              Anahtar Teslim Tadilat & Taahhüt
            </span>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed max-w-md pt-2">
          {siteConfig.description}
        </p>

        <!-- Stats Counter Small -->
        <div class="flex items-center gap-6 pt-3">
          <div>
            <div class="text-2xl font-bold font-serif-heading text-gold-400">{siteConfig.yearsOfExperience}+ Yıl</div>
            <div class="text-xs text-slate-400">Sektör Deneyimi</div>
          </div>
          <div class="h-8 w-px bg-anthracite-800"></div>
          <div>
            <div class="text-2xl font-bold font-serif-heading text-gold-400">{siteConfig.completedProjects}+</div>
            <div class="text-xs text-slate-400">Tamamlanan Proje</div>
          </div>
          <div class="h-8 w-px bg-anthracite-800"></div>
          <div>
            <div class="text-2xl font-bold font-serif-heading text-gold-400">%{siteConfig.customerSatisfaction}</div>
            <div class="text-xs text-slate-400">Müşteri Memnuniyeti</div>
          </div>
        </div>
      </div>

      <!-- Quick Services Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white border-l-2 border-gold-500 pl-3">
          Hizmetlerimiz
        </h4>
        <ul class="space-y-2.5 text-sm">
          {services.map((service) => (
            <li>
              <a href={`/hizmetler/${service.slug}`} class="text-slate-400 hover:text-gold-400 transition-colors flex items-center gap-1.5">
                <svg class="w-3 h-3 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                {service.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/hizmetler" class="text-gold-400 hover:text-gold-300 text-xs font-semibold uppercase tracking-wider flex items-center gap-1 pt-1">
              Tüm Hizmetler Listesi →
            </a>
          </li>
        </ul>
      </div>

      <!-- Fast Links Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white border-l-2 border-gold-500 pl-3">
          Hızlı Menü
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/hakkimizda" class="text-slate-400 hover:text-gold-400 transition-colors">Kurumsal & Hakkımızda</a></li>
          <li><a href="/surec" class="text-slate-400 hover:text-gold-400 transition-colors">5 Adımda Tadilat Süreci</a></li>
          <li><a href="/projeler" class="text-slate-400 hover:text-gold-400 transition-colors">Tamamlanan Projeler</a></li>
          <li><a href="/fiyat-hesapla" class="text-gold-400 font-medium hover:text-gold-300 transition-colors">✨ Fiyat & Keşif Hesaplama</a></li>
          <li><a href="/blog" class="text-slate-400 hover:text-gold-400 transition-colors">Tadilat Rehberi & Blog</a></li>
          <li><a href="/iletisim" class="text-slate-400 hover:text-gold-400 transition-colors">Bize Ulaşın</a></li>
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white border-l-2 border-gold-500 pl-3">
          İletişim & Ofis
        </h4>
        <div class="space-y-3 text-sm text-slate-400">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-gold-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{siteConfig.address}, {siteConfig.city}</span>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${siteConfig.phoneRaw}`} class="hover:text-gold-400 transition-colors font-medium text-white">{siteConfig.phone}</a>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <a href={`https://wa.me/${siteConfig.whatsappRaw}`} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-medium">
              WhatsApp: {siteConfig.whatsapp}
            </a>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-gold-400 transition-colors">{siteConfig.email}</a>
          </p>

          <div class="pt-2">
            <button 
              type="button" 
              data-open-inspection-modal
              class="w-full py-2.5 px-4 rounded-lg bg-gold-500/10 border border-gold-500/40 text-gold-400 hover:bg-gold-500 hover:text-anthracite-950 font-semibold text-xs tracking-wider uppercase transition-all duration-200"
            >
              Ücretsiz Keşif Formu
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="mt-12 pt-8 border-t border-anthracite-800/80 flex flex-col md:flex-row justify-between items-center text-xs text-slate-500 gap-4">
      <p>© {currentYear} {siteConfig.legalName} Tüm hakları saklıdır.</p>
      <div class="flex items-center space-x-6">
        <a href="/hakkimizda" class="hover:text-slate-400">Hakkımızda</a>
        <a href="/surec" class="hover:text-slate-400">Garanti Koşulları</a>
        <a href="/iletisim" class="hover:text-slate-400">KVKK ve Aydınlatma Metni</a>
      </div>
    </div>
  </div>
</footer>

