---
import { siteConfig } from "../data/siteConfig";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Evinizi veya İş Yerinizi Yenilemeye Hazır mısınız?",
  description = "Sürpriz maliyet olmadan, aracısız doğrudan usta işçiliği, yazılı sabit fiyat sözleşmesi ve 5 yıl işçilik garantisiyle hayalinizdeki mekana kavuşun.",
} = Astro.props;
---

<section class="py-20 relative overflow-hidden bg-anthracite-950 text-white">
  <!-- Subtle architectural background pattern -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#C5A059_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center">
    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Konya'da 24 Saat İçinde Yerinde Keşif
    </span>

    <h2 class="text-3xl sm:text-5xl font-serif-heading font-extrabold text-white tracking-tight mb-6">
      {title}
    </h2>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-light">
      {description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <button 
        type="button" 
        data-open-inspection-modal
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-base shadow-gold-glow hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2.5 cursor-pointer"
      >
        <span>Ücretsiz Keşif Randevusu Al</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>

      <a 
        href={`https://wa.me/${siteConfig.whatsappRaw}?text=Merhaba,%20anahtar%20teslim%20tadilat%20hakkında%20bilgi%20ve%20ücretsiz%20keşif%20randevusu%20almak%20istiyorum.`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-anthracite-900 border border-anthracite-700 hover:border-gold-500 text-white font-semibold text-base hover:bg-anthracite-800 transition-all flex items-center justify-center gap-2.5"
      >
        <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp ile Danışın</span>
      </a>
    </div>

    <!-- Guarantees Pills -->
    <div class="mt-12 pt-8 border-t border-anthracite-800/80 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-300 font-medium">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Sözleşmeli Sabit Fiyat
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        5 Yıl İşçilik Garantisi
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Gecikme Cezalı Teslimat
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Doğrudan Usta İşi
      </span>
    </div>
  </div>
</section>

