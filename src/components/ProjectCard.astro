---
import type { ProjectItem } from "../data/projects";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<div class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-card-elevated hover:shadow-2xl hover:border-gold-500/40 transition-all duration-300 flex flex-col group">
  <!-- Image Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-anthracite-950">
    <img 
      src={project.afterImage} 
      alt={project.title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-anthracite-950/80 via-transparent to-transparent"></div>

    <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-anthracite-900/90 text-gold-400 text-xs font-bold tracking-wide uppercase backdrop-blur-sm border border-gold-500/30">
      {project.categoryLabel}
    </span>

    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs">
      <span class="flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        {project.location}
      </span>
      <span class="bg-black/40 backdrop-blur-sm px-2.5 py-0.5 rounded border border-white/10 font-serif-heading font-semibold text-gold-300">
        {project.area}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold font-serif-heading text-anthracite-950 mb-2 group-hover:text-gold-600 transition-colors">
        {project.title}
      </h3>

      <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
        {project.description}
      </p>

      <!-- Highlights tags -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        {project.highlights.map((tag) => (
          <span class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Bottom Action & Testimonial quote snippet if exists -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
      <span class="text-slate-500 font-medium flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {project.duration}
      </span>

      <a 
        href={`/projeler#${project.id}`} 
        class="font-bold text-anthracite-950 hover:text-gold-600 flex items-center gap-1 group-hover:translate-x-1 transition-all"
      >
        <span>Öncesi / Sonrası</span>
        <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

