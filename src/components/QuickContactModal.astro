---
import { siteConfig } from "../data/siteConfig";
import { services } from "../data/services";
---

<div id="quick-inspection-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <!-- Backdrop -->
  <div id="modal-backdrop" class="fixed inset-0 bg-anthracite-950/80 backdrop-blur-sm transition-opacity"></div>

  <!-- Modal Box -->
  <div class="relative bg-anthracite-900 border border-gold-500/30 rounded-2xl w-full max-w-lg shadow-2xl p-5 sm:p-8 text-white z-10 max-h-[92vh] overflow-y-auto">
    <!-- Close Button -->
    <button 
      id="close-modal-btn" 
      type="button" 
      aria-label="Kapat"
      class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 rounded-lg hover:bg-anthracite-800 transition-colors"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-2">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Ücretsiz Keşif & 3D Tasarım
      </div>
      <h3 class="text-2xl font-serif-heading font-bold text-white">
        Projenizi Birlikte Planlayalım
      </h3>
      <p class="text-xs text-slate-400 mt-1">
        Formu doldurun, mimar ekibimiz 15 dakika içinde sizi arayarak yerinde ücretsiz keşif randevusu oluştursun.
      </p>
    </div>

    <form id="inspection-modal-form" class="space-y-4">
      <div>
        <label for="modal-name" class="block text-xs font-medium text-slate-300 mb-1">Adınız Soyadınız *</label>
        <input 
          type="text" 
          id="modal-name" 
          required 
          placeholder="Örn: Ahmet Yılmaz"
          class="w-full px-3.5 py-2.5 bg-anthracite-950 border border-anthracite-700 rounded-lg text-sm text-white focus:outline-none focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="modal-phone" class="block text-xs font-medium text-slate-300 mb-1">Telefon Numaranız *</label>
          <input 
            type="tel" 
            id="modal-phone" 
            required 
            placeholder="05XX XXX XX XX"
            class="w-full px-3.5 py-2.5 bg-anthracite-950 border border-anthracite-700 rounded-lg text-sm text-white focus:outline-none focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
          />
        </div>
        <div>
          <label for="modal-district" class="block text-xs font-medium text-slate-300 mb-1">İlçe / Semt *</label>
          <input 
            type="text" 
            id="modal-district" 
            required 
            placeholder="Örn: Kadıköy, Beşiktaş"
            class="w-full px-3.5 py-2.5 bg-anthracite-950 border border-anthracite-700 rounded-lg text-sm text-white focus:outline-none focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
          />
        </div>
      </div>

      <div>
        <label for="modal-service" class="block text-xs font-medium text-slate-300 mb-1">Tadilat Kapsamı *</label>
        <select 
          id="modal-service" 
          class="w-full px-3.5 py-2.5 bg-anthracite-950 border border-anthracite-700 rounded-lg text-sm text-white focus:outline-none focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        >
          {services.map((s) => (
            <option value={s.title}>{s.title}</option>
          ))}
          <option value="Diğer Özel Proje">Diğer Özel Proje</option>
        </select>
      </div>

      <div>
        <label for="modal-notes" class="block text-xs font-medium text-slate-300 mb-1">Mekan Bilgisi / Notunuz (İsteğe Bağlı)</label>
        <textarea 
          id="modal-notes" 
          rows="2" 
          placeholder="Örn: 130 m² 3+1 daire, mutfak ve salon birleştirilecek..."
          class="w-full px-3.5 py-2 bg-anthracite-950 border border-anthracite-700 rounded-lg text-sm text-white focus:outline-none focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        ></textarea>
      </div>

      <div class="pt-2">
        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-sm rounded-lg shadow-gold-glow hover:brightness-110 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Ücretsiz Keşif Randevusu Oluştur</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>

      <p class="text-[11px] text-center text-slate-400">
        🔒 Bilgileriniz KVKK kapsamında korunmakta olup asla 3. şahıslarla paylaşılmaz.
      </p>
    </form>

    <div id="modal-success" class="hidden text-center py-8 space-y-3">
      <div class="w-14 h-14 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h4 class="text-xl font-bold text-white">Talebiniz Alındı!</h4>
      <p class="text-sm text-slate-300">
        Mimarlarımız en kısa sürede sizinle iletişime geçecektir. Dilerseniz hemen WhatsApp üzerinden de detay iletebilirsiniz.
      </p>
      <a 
        id="modal-wa-direct" 
        href={`https://wa.me/${siteConfig.whatsappRaw}`} 
        target="_blank" 
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-500 transition-colors mt-2"
      >
        WhatsApp İle Hızlıca Devam Et →
      </a>
    </div>
  </div>
</div>

<script define:vars={{ whatsappRaw: siteConfig.whatsappRaw }}>
  const form = document.getElementById('inspection-modal-form');
  const successBox = document.getElementById('modal-success');
  const waDirect = document.getElementById('modal-wa-direct');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('modal-name')?.value || '';
    const phone = document.getElementById('modal-phone')?.value || '';
    const district = document.getElementById('modal-district')?.value || '';
    const service = document.getElementById('modal-service')?.value || '';
    const notes = document.getElementById('modal-notes')?.value || '';

    const text = encodeURIComponent(
      `Merhaba Artı Mimarlık, web sitenizden Ücretsiz Keşif formu doldurdum:\n` +
      `👤 İsim: ${name}\n` +
      `📞 Tel: ${phone}\n` +
      `📍 İlçe: ${district}\n` +
      `🔨 Hizmet: ${service}\n` +
      `📝 Not: ${notes || 'Belirtilmedi'}`
    );

    if (waDirect) {
      waDirect.href = `https://wa.me/${whatsappRaw}?text=${text}`;
    }

    form.classList.add('hidden');
    successBox?.classList.remove('hidden');
  });
</script>

