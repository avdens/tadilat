---
import { siteConfig } from "../data/siteConfig";
---

<div id="cost-calculator-container" class="bg-anthracite-900 border border-gold-500/30 rounded-3xl p-4 sm:p-10 shadow-2xl relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute -top-24 -right-24 w-80 h-80 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-wider mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
        Şeffaf ve Anında Bütçe Analizi
      </span>
      <h3 class="text-2xl sm:text-3xl font-serif-heading font-bold text-white">
        Tadilat Maliyetinizi 1 Dakikada Hesaplayın
      </h3>
      <p class="text-sm text-slate-300 mt-2">
        Mekanınızın özelliklerini seçin, ortalama bütçe aralığını ve teslimat süresini kuruşu kuruşuna şeffaf olarak görün.
      </p>
    </div>

    <!-- Step 1: Space Type -->
    <div class="mb-8">
      <label class="block text-sm font-semibold text-slate-200 mb-3">
        1. Tadilat Yapılacak Mekan Türü
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3" id="space-type-selector">
        <button 
          type="button" 
          data-type="daire" 
          data-base="8500"
          class="space-type-btn active flex flex-col items-center justify-center p-3.5 rounded-xl border border-gold-500 bg-gold-500/10 text-white transition-all hover:border-gold-400 group"
        >
          <span class="text-2xl mb-1 group-hover:scale-110 transition-transform">🏢</span>
          <span class="text-xs font-semibold">Ev & Daire</span>
        </button>

        <button 
          type="button" 
          data-type="villa" 
          data-base="13500"
          class="space-type-btn flex flex-col items-center justify-center p-3.5 rounded-xl border border-anthracite-700 bg-anthracite-950/60 text-slate-300 transition-all hover:border-gold-500 group"
        >
          <span class="text-2xl mb-1 group-hover:scale-110 transition-transform">🏡</span>
          <span class="text-xs font-semibold">Müstakil Villa</span>
        </button>

        <button 
          type="button" 
          data-type="ofis" 
          data-base="7200"
          class="space-type-btn flex flex-col items-center justify-center p-3.5 rounded-xl border border-anthracite-700 bg-anthracite-950/60 text-slate-300 transition-all hover:border-gold-500 group"
        >
          <span class="text-2xl mb-1 group-hover:scale-110 transition-transform">💼</span>
          <span class="text-xs font-semibold">Ofis & Ticari</span>
        </button>

        <button 
          type="button" 
          data-type="mutfak-banyo" 
          data-base="16000"
          class="space-type-btn flex flex-col items-center justify-center p-3.5 rounded-xl border border-anthracite-700 bg-anthracite-950/60 text-slate-300 transition-all hover:border-gold-500 group"
        >
          <span class="text-2xl mb-1 group-hover:scale-110 transition-transform">🍳</span>
          <span class="text-xs font-semibold">Mutfak & Banyo</span>
        </button>

        <button 
          type="button" 
          data-type="bina" 
          data-base="3200"
          class="space-type-btn flex flex-col items-center justify-center p-3.5 rounded-xl border border-anthracite-700 bg-anthracite-950/60 text-slate-300 transition-all hover:border-gold-500 group"
        >
          <span class="text-2xl mb-1 group-hover:scale-110 transition-transform">🏗️</span>
          <span class="text-xs font-semibold">Bina Dış Cephe</span>
        </button>
      </div>
    </div>

    <!-- Step 2: Area Slider -->
    <div class="mb-8 bg-anthracite-950/60 border border-anthracite-800 p-5 rounded-2xl">
      <div class="flex justify-between items-center mb-3">
        <label for="area-range" class="text-sm font-semibold text-slate-200">
          2. Alan Büyüklüğü (m²)
        </label>
        <div class="flex items-center gap-1.5 bg-anthracite-900 border border-gold-500/40 px-3 py-1 rounded-lg">
          <span id="area-display" class="text-lg font-bold font-serif-heading text-gold-400">120</span>
          <span class="text-xs text-slate-400 font-medium">m²</span>
        </div>
      </div>
      <input 
        type="range" 
        id="area-range" 
        min="30" 
        max="500" 
        step="5" 
        value="120"
        class="w-full h-2 bg-anthracite-800 rounded-lg appearance-none cursor-pointer accent-gold-500"
      />
      <div class="flex justify-between text-[11px] text-slate-500 mt-2">
        <span>30 m² (Stüdyo / Tek Oda)</span>
        <span>150 m² (Geniş Daire)</span>
        <span>500+ m² (Villa / Ofis)</span>
      </div>
    </div>

    <!-- Step 3: Material Tier -->
    <div class="mb-8">
      <label class="block text-sm font-semibold text-slate-200 mb-3">
        3. Malzeme ve Tasarım Segmenti
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="tier-selector">
        <label class="tier-card cursor-pointer border border-anthracite-700 bg-anthracite-950/60 rounded-xl p-4 flex flex-col justify-between hover:border-gold-500 transition-colors">
          <div>
            <div class="flex justify-between items-center mb-1">
              <span class="text-sm font-bold text-white">Standart Paket</span>
              <input type="radio" name="tier" value="1" class="text-gold-500 focus:ring-gold-500" />
            </div>
            <p class="text-xs text-slate-400">1. Sınıf yerli malzeme, Jotun boya, standart seramik ve laminat parke.</p>
          </div>
          <span class="text-[11px] text-slate-300 font-medium mt-3 block">Ekonomik & Güvenilir</span>
        </label>

        <label class="tier-card active cursor-pointer border border-gold-500 bg-gold-500/10 rounded-xl p-4 flex flex-col justify-between hover:border-gold-400 transition-colors">
          <div>
            <div class="flex justify-between items-center mb-1">
              <span class="text-sm font-bold text-gold-400 flex items-center gap-1.5">
                Konfor & Prestij
                <span class="text-[9px] bg-gold-500 text-anthracite-950 font-bold px-1.5 py-0.5 rounded">Popüler</span>
              </span>
              <input type="radio" name="tier" value="1.35" checked class="text-gold-500 focus:ring-gold-500" />
            </div>
            <p class="text-xs text-slate-300">Özel 3D mimari tasarım, lake iç kapı & dolap, ithal batarya (Grohe/Artema), büyük ebat seramik.</p>
          </div>
          <span class="text-[11px] text-gold-400 font-medium mt-3 block">Estetik & Fonksiyonel</span>
        </label>

        <label class="tier-card cursor-pointer border border-anthracite-700 bg-anthracite-950/60 rounded-xl p-4 flex flex-col justify-between hover:border-gold-500 transition-colors">
          <div>
            <div class="flex justify-between items-center mb-1">
              <span class="text-sm font-bold text-white">Lüks & Signature</span>
              <input type="radio" name="tier" value="1.85" class="text-gold-500 focus:ring-gold-500" />
            </div>
            <p class="text-xs text-slate-400">Doğal mermer kaplama, masif lamine ahşap, özel tasarım aydınlatma, akıllı ev altyapısı.</p>
          </div>
          <span class="text-[11px] text-slate-300 font-medium mt-3 block">Ultra Premium Standart</span>
        </label>
      </div>
    </div>

    <!-- Step 4: Optional Add-ons -->
    <div class="mb-8">
      <label class="block text-sm font-semibold text-slate-200 mb-3">
        4. İlave İhtiyaçlar (İsteğe Bağlı)
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="addons-selector">
        <label class="flex items-center gap-3 p-3 bg-anthracite-950/40 border border-anthracite-800 rounded-xl cursor-pointer hover:border-gold-500/50 transition-colors">
          <input type="checkbox" data-addon="yerden-isitma" data-price="950" class="addon-checkbox rounded text-gold-500 focus:ring-gold-500 bg-anthracite-900 border-anthracite-700" />
          <div class="text-xs">
            <span class="font-medium text-white block">Rehau Yerden Isıtma Sistemi</span>
            <span class="text-slate-400 text-[11px]">+950 ₺/m²</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-3 bg-anthracite-950/40 border border-anthracite-800 rounded-xl cursor-pointer hover:border-gold-500/50 transition-colors">
          <input type="checkbox" data-addon="akilli-ev" data-price="75000" class="addon-checkbox rounded text-gold-500 focus:ring-gold-500 bg-anthracite-900 border-anthracite-700" />
          <div class="text-xs">
            <span class="font-medium text-white block">KNX Akıllı Ev Otomasyonu</span>
            <span class="text-slate-400 text-[11px]">Sabit paket: +75.000 ₺</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-3 bg-anthracite-950/40 border border-anthracite-800 rounded-xl cursor-pointer hover:border-gold-500/50 transition-colors">
          <input type="checkbox" data-addon="akustik-tavan" data-price="650" class="addon-checkbox rounded text-gold-500 focus:ring-gold-500 bg-anthracite-900 border-anthracite-700" />
          <div class="text-xs">
            <span class="font-medium text-white block">Gizli LED'li Asma Tavan & İzolasyon</span>
            <span class="text-slate-400 text-[11px]">+650 ₺/m²</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-3 bg-anthracite-950/40 border border-anthracite-800 rounded-xl cursor-pointer hover:border-gold-500/50 transition-colors">
          <input type="checkbox" data-addon="klima" data-price="65000" class="addon-checkbox rounded text-gold-500 focus:ring-gold-500 bg-anthracite-900 border-anthracite-700" />
          <div class="text-xs">
            <span class="font-medium text-white block">Multi-Split / VRF Klima Altyapısı</span>
            <span class="text-slate-400 text-[11px]">Sabit tesisat: +65.000 ₺</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Calculation Result Card -->
    <div class="p-6 sm:p-8 bg-gradient-to-br from-anthracite-950 via-anthracite-900 to-anthracite-950 border-2 border-gold-500/50 rounded-2xl shadow-gold-glow">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-anthracite-800">
        <div>
          <span class="text-xs uppercase tracking-wider text-gold-400 font-semibold block mb-1">
            Tahmini Anahtar Teslim Bütçe Aralığı
          </span>
          <div class="text-2xl sm:text-4xl font-serif-heading font-extrabold text-white flex flex-wrap items-baseline gap-1.5 sm:gap-2">
            <span id="price-min">980.000</span> - <span id="price-max">1.250.000</span> <span class="text-gold-400 text-lg sm:text-xl font-sans">₺</span>
          </div>
          <span class="text-[11px] text-slate-400 block mt-1">
            * KDV hariç ortalama malzeme + 1. sınıf işçilik ve anahtar teslim montaj bedelidir.
          </span>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end gap-3 sm:gap-1 bg-anthracite-800/60 px-4 py-2.5 rounded-xl border border-anthracite-700">
          <span class="text-xs text-slate-400">Tahmini Teslimat Süresi:</span>
          <span id="duration-estimate" class="text-base font-bold text-gold-400 font-serif-heading">30 - 40 İş Günü</span>
        </div>
      </div>

      <div class="pt-6 flex flex-col sm:flex-row items-center gap-4">
        <button 
          type="button" 
          id="calc-inquire-btn"
          class="w-full sm:w-auto flex-1 py-3.5 px-6 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-anthracite-950 font-bold text-sm shadow-gold-glow hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Bu Hesaplamayla Ücretsiz Keşif İste</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <a 
          id="calc-wa-btn"
          href={`https://wa.me/${siteConfig.whatsappRaw}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto py-3.5 px-6 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-500 transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp ile İlet</span>
        </a>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-6 text-[11px] text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Sözleşmeli Sabit Fiyat Garantisi
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          5 Yıl İşçilik Garantisi
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Gecikme Cezalı Teslimat Taahhüdü
        </span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ whatsappRaw: siteConfig.whatsappRaw }}>
  const spaceBtns = document.querySelectorAll('.space-type-btn');
  const areaRange = document.getElementById('area-range');
  const areaDisplay = document.getElementById('area-display');
  const tierCards = document.querySelectorAll('.tier-card');
  const addonCheckboxes = document.querySelectorAll('.addon-checkbox');
  const priceMinEl = document.getElementById('price-min');
  const priceMaxEl = document.getElementById('price-max');
  const durationEl = document.getElementById('duration-estimate');
  const calcWaBtn = document.getElementById('calc-wa-btn');
  const calcInquireBtn = document.getElementById('calc-inquire-btn');

  let currentBasePrice = 8500;
  let currentTypeName = 'Ev & Daire';
  let currentArea = 120;
  let currentTierMultiplier = 1.35;
  let currentTierName = 'Konfor & Prestij';

  function formatNumber(num) {
    return new Intl.NumberFormat('tr-TR').format(Math.round(num));
  }

  function recalculate() {
    let baseTotal = currentArea * currentBasePrice * currentTierMultiplier;

    // Addons
    addonCheckboxes.forEach((cb) => {
      if (cb.checked) {
        const p = parseFloat(cb.dataset.price || '0');
        if (cb.dataset.addon === 'yerden-isitma' || cb.dataset.addon === 'akustik-tavan') {
          baseTotal += currentArea * p;
        } else {
          baseTotal += p;
        }
      }
    });

    const minPrice = Math.round(baseTotal * 0.95 / 1000) * 1000;
    const maxPrice = Math.round(baseTotal * 1.15 / 1000) * 1000;

    if (priceMinEl) priceMinEl.textContent = formatNumber(minPrice);
    if (priceMaxEl) priceMaxEl.textContent = formatNumber(maxPrice);

    // Duration calculation
    let daysMin = 25;
    let daysMax = 35;
    if (currentArea > 150) {
      daysMin = Math.round(25 + (currentArea - 150) * 0.15);
      daysMax = Math.round(daysMin * 1.3);
    }
    if (durationEl) {
      durationEl.textContent = `${daysMin} - ${daysMax} İş Günü`;
    }

    // Update WhatsApp link
    if (calcWaBtn) {
      const waText = encodeURIComponent(
        `Merhaba HS Dekorasyon, sitedeki Fiyat Hesaplayıcı ile Konya için bir hesaplama yaptım:\n` +
        `🏠 Mekan Türü: ${currentTypeName}\n` +
        `📐 Alan: ${currentArea} m²\n` +
        `⭐ Paket: ${currentTierName}\n` +
        `💰 Tahmini Bütçe: ${formatNumber(minPrice)} - ${formatNumber(maxPrice)} TL\n` +
        `Bu hesaplama için Konya'da yerinde ücretsiz keşif randevusu almak istiyorum.`
      );
      calcWaBtn.href = `https://wa.me/${whatsappRaw}?text=${waText}`;
    }
  }

  // Space type click
  spaceBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      spaceBtns.forEach(b => {
        b.classList.remove('active', 'border-gold-500', 'bg-gold-500/10', 'text-white');
        b.classList.add('border-anthracite-700', 'bg-anthracite-950/60', 'text-slate-300');
      });
      btn.classList.add('active', 'border-gold-500', 'bg-gold-500/10', 'text-white');
      btn.classList.remove('border-anthracite-700', 'bg-anthracite-950/60', 'text-slate-300');
      
      currentBasePrice = parseFloat(btn.dataset.base || '8500');
      currentTypeName = btn.querySelector('.font-semibold')?.textContent || 'Ev & Daire';
      recalculate();
    });
  });

  // Area slider input
  areaRange?.addEventListener('input', (e) => {
    currentArea = parseInt(e.target.value);
    if (areaDisplay) areaDisplay.textContent = currentArea.toString();
    recalculate();
  });

  // Tier radio clicks
  tierCards.forEach((card) => {
    card.addEventListener('click', () => {
      const radio = card.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      tierCards.forEach(c => {
        c.classList.remove('active', 'border-gold-500', 'bg-gold-500/10');
        c.classList.add('border-anthracite-700', 'bg-anthracite-950/60');
      });
      card.classList.add('active', 'border-gold-500', 'bg-gold-500/10');
      card.classList.remove('border-anthracite-700', 'bg-anthracite-950/60');

      currentTierMultiplier = parseFloat(radio.value);
      currentTierName = card.querySelector('.font-bold')?.textContent?.trim() || 'Paket';
      recalculate();
    });
  });

  // Addons checkbox changes
  addonCheckboxes.forEach((cb) => {
    cb.addEventListener('change', recalculate);
  });

  // Inquire button triggers modal
  calcInquireBtn?.addEventListener('click', () => {
    const modalTrigger = document.querySelector('[data-open-inspection-modal]');
    if (modalTrigger) {
      modalTrigger.click();
      const notesEl = document.getElementById('modal-notes');
      if (notesEl) {
        notesEl.value = `Hesaplayıcı Özeti: ${currentTypeName}, ${currentArea} m², ${currentTierName} paketi.`;
      }
    }
  });

  // Initial calculation run
  recalculate();
</script>

