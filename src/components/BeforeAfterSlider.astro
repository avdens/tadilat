---
interface Props {
  beforeImage: string;
  afterImage: string;
  beforeLabel?: string;
  afterLabel?: string;
  title?: string;
  subtitle?: string;
}

const {
  beforeImage,
  afterImage,
  beforeLabel = "ÖNCESİ",
  afterLabel = "SONRASI",
  title,
  subtitle,
} = Astro.props;

// Unique ID for multiple sliders on the same page
const sliderId = `ba-slider-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="space-y-3">
  {(title || subtitle) && (
    <div class="flex items-center justify-between">
      {title && <h4 class="text-base font-bold text-white">{title}</h4>}
      {subtitle && <span class="text-xs text-gold-400 font-medium">{subtitle}</span>}
    </div>
  )}

  <div 
    id={sliderId} 
    class="relative w-full aspect-[16/10] sm:aspect-[16/9] rounded-2xl overflow-hidden select-none cursor-ew-resize shadow-2xl border border-anthracite-700/60 group touch-none"
  >
    <!-- After Image (Base / Full Background) -->
    <img 
      src={afterImage} 
      alt="Tadilat Sonrası" 
      class="absolute inset-0 w-full h-full object-cover pointer-events-none" 
      loading="lazy"
    />
    <div class="absolute bottom-4 right-4 z-10 px-3 py-1 rounded-full bg-gold-500/90 text-anthracite-950 font-bold text-xs uppercase tracking-wider backdrop-blur-sm shadow-md pointer-events-none">
      {afterLabel}
    </div>

    <!-- Before Image (Clipped with clip-path, perfectly aligned) -->
    <div 
      class="before-image-layer absolute inset-0 w-full h-full pointer-events-none"
      style="clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);"
    >
      <img 
        src={beforeImage} 
        alt="Tadilat Öncesi" 
        class="w-full h-full object-cover pointer-events-none" 
        loading="lazy"
      />
      <div class="absolute bottom-4 left-4 z-10 px-3 py-1 rounded-full bg-anthracite-950/90 text-white font-bold text-xs uppercase tracking-wider backdrop-blur-sm border border-white/20 shadow-md">
        {beforeLabel}
      </div>
    </div>

    <!-- Draggable Divider Line & Handle -->
    <div 
      class="divider-handle absolute top-0 bottom-0 z-20 pointer-events-none flex items-center justify-center -translate-x-1/2"
      style="left: 50%;"
    >
      <div class="w-0.5 h-full bg-gold-400 shadow-[0_0_10px_rgba(197,160,89,0.8)]"></div>
      
      <div class="absolute w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gold-500 text-anthracite-950 shadow-gold-glow flex items-center justify-center border-2 border-white pointer-events-auto transition-transform group-hover:scale-110 active:scale-95 cursor-ew-resize">
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l-3 3m0 0l3 3m-3-3h14m-3-3l3 3m0 0l-3 3"/>
        </svg>
      </div>
    </div>

    <!-- Drag instruction tooltip -->
    <div class="absolute top-4 left-1/2 -translate-x-1/2 z-10 pointer-events-none opacity-80 group-hover:opacity-0 transition-opacity bg-black/60 backdrop-blur-sm px-3 py-1 rounded-full text-[10px] sm:text-[11px] text-white">
      ↔ Kaydırarak İnceleyin
    </div>
  </div>
</div>

<script define:vars={{ sliderId }}>
  const container = document.getElementById(sliderId);
  if (container) {
    const beforeLayer = container.querySelector('.before-image-layer');
    const handle = container.querySelector('.divider-handle');

    let isDown = false;

    function updateSlider(xPos) {
      const rect = container.getBoundingClientRect();
      let pos = (xPos - rect.left) / rect.width;
      pos = Math.max(0.01, Math.min(0.99, pos));
      const percent = pos * 100;

      if (beforeLayer) {
        beforeLayer.style.clipPath = `polygon(0 0, ${percent}% 0, ${percent}% 100%, 0 100%)`;
      }
      if (handle) {
        handle.style.left = `${percent}%`;
      }
    }

    // Mouse events
    container.addEventListener('mousedown', (e) => {
      isDown = true;
      updateSlider(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
    });

    container.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      updateSlider(e.clientX);
    });

    // Touch events for mobile/tablets
    container.addEventListener('touchstart', (e) => {
      isDown = true;
      if (e.touches[0]) updateSlider(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDown = false;
    });

    container.addEventListener('touchmove', (e) => {
      if (!isDown) return;
      if (e.touches[0]) updateSlider(e.touches[0].clientX);
    }, { passive: true });
  }
</script>
